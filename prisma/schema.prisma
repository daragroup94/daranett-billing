datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id             String    @id @default(uuid())
  name           String
  phone          String
  address        String
  wilayah        String?   // Wilayah / Rute penagihan
  ipAddress      String?
  pppoeUsername  String?
  pppoePassword  String?
  dueDate        Int       // Day of month, e.g., 1 to 31
  dueTime        String    @default("10:00") // Due time, e.g., "10:00"
  discount       Float     @default(0)       // Monthly recurring discount/fee reduction
  carriedOverDebt Float     @default(0)       // Debt carried over from unpaid parts of previous bills
  status         String    // "ACTIVE" or "SUSPENDED" or "GRACE"
  packageId      String
  package        Package   @relation(fields: [packageId], references: [id])
  invoices       Invoice[]
  joinDate       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Package {
  id            String     @id @default(uuid())
  name          String
  speedUpload   Int        // Mbps
  speedDownload Int        // Mbps
  price         Float      // Price in Rupiah
  description   String?
  customers     Customer[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Invoice {
  id            String    @id @default(uuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  month         String    // format "YYYY-MM", e.g., "2026-05"
  amount        Float     // Base package price
  discount      Float     @default(0) // Discount applied to this specific invoice
  status        String    // "PAID" or "UNPAID"
  paymentDate   DateTime?
  paymentMethod String?   // "CASH", "TRANSFER", "QRIS"
  notes         String?   // Custom payment or billing notes
  promiseDate   DateTime? // Tanggal Janji Bayar
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([customerId, month])
}

model SystemSettings {
  id                    String   @id @default("default")
  telegramBotToken      String   @default("")
  telegramChatId        String   @default("")
  lastSentDate          String   @default("")
  lastSentWaDate        String   @default("")
  adminPassword         String   @default("admin")
  fonnteBotToken        String   @default("")
  fonnteTargetPhone     String   @default("")
  
  // Mikrotik Settings
  mikrotikHost          String   @default("")
  mikrotikPort          Int      @default(80)
  mikrotikUsername      String   @default("")
  mikrotikPassword      String   @default("")
  mikrotikIsolirProfile String   @default("ISOLIR")

  // Midtrans Settings
  midtransServerKey     String   @default("")
  midtransClientKey     String   @default("")
  midtransIsProduction  Boolean  @default(false)

  // Cron Settings
  cronToken             String   @default("")

  updatedAt             DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(uuid())
  action    String
  message   String
  createdAt DateTime @default(now())
}

model Expense {
  id            String   @id @default(uuid())
  title         String
  category      String   // "UPSTREAM", "INFRASTRUCTURE", "SALARY", "UTILITIES", "MAINTENANCE", "MARKETING", "OTHER"
  amount        Float
  date          DateTime @default(now())
  paymentMethod String?  @default("TRANSFER")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([category])
}

